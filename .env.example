# pt-media-os V1 — Environment Variables
# Copy this file to .env and fill in values
# Last updated: 2026-04-25

# ============================================================================
# DATABASE (required)
# ============================================================================
DATABASE_URL=postgresql://ptmedia:ptmedia@localhost:5432/pt_media_os

# ============================================================================
# AI PROVIDERS
# ============================================================================

# Ollama (local — embeddings + fast extraction)
OLLAMA_HOST=http://localhost:11434

# NVIDIA NIM (cloud — primary for framing/summarization)
# Free tier: 1,000 credits, 40 RPM
# Get key at: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Groq (cloud — fallback for framing/summarization)
# Free tier: 30 RPM, 14,400 tokens/day
# Get key at: https://console.groq.com/
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (cloud — last-resort fallback)
# Get key at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# REVIEW UI AUTH (required for review interface)
# ============================================================================
REVIEW_USERNAME=admin
REVIEW_PASSWORD_HASH=argon2$...  # Generate with: python -c "import hashlib; print(hashlib.sha256(b'changeme').hexdigest())"
# In V1, use simple HTTP Basic Auth. Replace changeme with a strong password.

# ============================================================================
# REDIS (optional — for job queue / caching)
# If not set, services use Postgres-based polling for task coordination.
# ============================================================================
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# SCHEDULING
# ============================================================================
# Cron expressions for service scheduling (APScheduler format)
INGESTION_CRON=*/30 * * * *          # every 30 minutes
INSTITUTIONAL_CRON=0 */4 * * *       # every 4 hours
DIGEST_CRON=0 7 * * *                # daily at 07:00 UTC (08:00 Lisbon)

# ============================================================================
# EMBEDDING / CLUSTERING (tuneable)
# ============================================================================
EMBEDDING_DIM=768                     # nomic-embed-text dimension — do not change
CLUSTERING_SIMILARITY_THRESHOLD=0.85  # cosine similarity for same-event match
CLUSTERING_TIME_WINDOW_HOURS=72       # only cluster articles within 72h of each other
CLUSTERING_MIN_ARTICLES=2            # minimum articles to promote event from candidate
CLUSTERING_MIN_OUTLETS=2             # minimum distinct outlets for event promotion
LUSA_SIMILARITY_THRESHOLD=0.88       # cosine similarity to flag lusa_likely

# ============================================================================
# PIPELINE TUNING
# ============================================================================
NORMALIZATION_BATCH_SIZE=50           # articles per normalization batch
EMBEDDING_BATCH_SIZE=20               # articles per embedding batch
ANALYSIS_BATCH_SIZE=10                # articles per AI analysis batch
MIN_ARTICLE_WORD_COUNT=80            # skip articles shorter than this

# ============================================================================
# OPTIONAL: OBJECT STORAGE (future — not used in V1)
# ============================================================================
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=pt-media-raw
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ============================================================================
# OPTIONAL: SEARCH INDEX (future — not used in V1)
# ============================================================================
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=xxxxxxxx

# ============================================================================
# APP SETTINGS
# ============================================================================
APP_ENV=development                   # development | staging | production
APP_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
APP_PORT=8000                         # FastAPI internal API port
REVIEW_UI_PORT=8001                   # Review UI port
